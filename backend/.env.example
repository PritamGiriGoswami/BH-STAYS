# BH Stays Backend - Environment Configuration
# Copy this file to `backend/.env` and fill in real values.
# Never commit `backend/.env` to the repository.

# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Auth ----
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- Database (SQLite) ----
DB_PATH=./data/bh-stays.sqlite

# ---- Static website frontend ----
STATIC_DIR=../frontend/web

# ---- Payments (Razorpay) ----
# Get these from https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret

# ---- Email (Resend) ----
# Get these from https://resend.com -> API Keys. Verify your domain for a custom from address.
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM=BH Stays <bookings@yourdomain.com>