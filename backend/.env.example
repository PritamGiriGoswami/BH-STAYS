# BH Stays Backend - Environment Configuration
# Copy this file to `backend/.env` and fill in real values.
# Never commit `backend/.env` to the repository.

# ---- Server ----
PORT=8000
NODE_ENV=development

# ---- Auth ----
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- Database (SQLite) ----
DB_PATH=./data/bh-stays.sqlite

# ---- Static frontend served by Express (project root) ----
STATIC_DIR=..